# --- 目标芯片 ---
CONFIG_IDF_TARGET="esp32c3"
# 注:ESP32-C3 无 PSRAM,故不设 CONFIG_SPIRAM。

# --- Flash ---
# WeMeet Passport 硬件基线使用 8MB Flash。
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
# 固定 8MB 镜像头，关闭 detect，便于 idf.py merge-bin。
CONFIG_ESPTOOLPY_HEADER_FLASHSIZE_UPDATE=n
# 分区:NVS、PHY data 和占用剩余空间的 factory app(中文字库约 3 MB,需要大 app 分区)。
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# --- 控制台:USB-Serial-JTAG(C3 原生 USB,GPIO18/19)---
# 不用 UART0:其默认 TX=GPIO21 与本板背光引脚冲突。
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# --- LVGL ---
CONFIG_LV_COLOR_DEPTH_16=y
# 20 ms display refresh period targets up to 50 FPS when rendering and SPI
# transfer complete within the same budget.
CONFIG_LV_DEF_REFR_PERIOD=20
# Montserrat 14 只作为回退链末端,提供 LVGL 内置图标字形;界面文字用 assets/fonts/wm_font_*。
CONFIG_LV_FONT_MONTSERRAT_14=y
# wm_font_28 的位图超过 1 MB,glyph_dsc.bitmap_index 需要 32 位(默认只有 20 位)。
CONFIG_LV_FONT_FMT_TXT_LARGE=y
# 开发期保留缺字占位框,让字库漏字可见。
CONFIG_LV_USE_FONT_PLACEHOLDER=y
# 签到码与配对页以二维码显示。
CONFIG_LV_USE_QRCODE=y
# LVGL 内置 malloc 池(KB)。独立静态区,不与系统堆共享。
# 预算:单页约 30 个对象 ≈ 6 KB;196 px 二维码画布(1 bpp)≈ 5 KB;二维码编码临时缓冲 ≈ 1 KB;
# 圆角/阴影蒙版与字形解码缓冲若干 KB。48 KB 留有一倍余量;出现绘制卡死时再调大。
CONFIG_LV_MEM_SIZE_KILOBYTES=48

# --- 系统 ---
CONFIG_FREERTOS_HZ=1000
# app_main 里要初始化 Wi-Fi 驱动并构建首屏(LVGL 建对象),默认 3.5 KB 主任务栈不够稳妥。
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# --- 无线 ---
# 本应用只用 Wi-Fi(配网走声波,不走蓝牙),关闭 BLE 省下约 60 KB RAM 和 300 KB Flash。
CONFIG_BT_ENABLED=n

# --- TLS ---
# 无 PSRAM:按需分配收发缓冲,握手后释放证书链,HTTPS 轮询期间的堆峰值可降低约 20 KB。
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CA_CERT=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y
